# BarentsWatch API client (https://www.barentswatch.no/minside/ → API clients)
BW_CLIENT_ID=
BW_CLIENT_SECRET=

# Observer location, decimal degrees (required)
LOS_LAT=
LOS_LON=

# Optional overrides (defaults shown)
# Arc bearings are degrees true; the arc sweeps clockwise from FROM to TO.
# LOS_ARC_FROM=120
# LOS_ARC_TO=270
# LOS_RADIUS_NM=12
# LOS_MAX_AGE=15m
# LOS_DB_PATH=/data/los.db
# LOS_ADDR=:8080
